# ---- Unity ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/WinBUILD/

# Asset Store et packages téléchargés
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---- Fichiers générés par les IDE ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.csproj.Backup.tmp

# ---- Builds ----
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/

# ---- Crash reports ----
sysinfo.txt
crashlytics-build.properties

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Ne PAS ignorer ----
# Les .meta sont indispensables : Unity casse ses références sans eux.
!*.meta

# Mesures d'équilibrage générées par Tools/Core/Équilibrage — jamais versionnées.
/BalanceReports/

# Archive de build : 174 Mo, reconstructible, et irretirable de l'historique une fois entrée.
/WinBUILD.7z
/WinBUILD/

# Sortie de l'outil graphify : dérivée du dépôt, jamais une source.
/graphify-out/

# Bytecode Python du simulateur d'équilibrage.
__pycache__/
*.pyc
